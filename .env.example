# UMP API root, including the API prefix (UMP_API_SERVER_URL_PREFIX)
UMP_MCP_UMP_API_BASE_URL=http://localhost:5000/api

# Keycloak as reachable from this service
UMP_MCP_KEYCLOAK_URL=http://localhost:8080
UMP_MCP_KEYCLOAK_REALM=UMP

# Set when tokens are issued under a public URL but Keycloak is reached
# internally under a different one (typical in k8s):
# UMP_MCP_KEYCLOAK_ISSUER=https://auth.example.com/realms/UMP
# UMP_MCP_JWKS_URL=http://keycloak:8080/realms/UMP/protocol/openid-connect/certs

# Expected JWT audience. Leaving this unset disables the audience check —
# configure a Keycloak audience mapper and set it in production.
# UMP_MCP_AUDIENCE=ump-client

# Accept requests without a JWT (UMP then only exposes anonymous-access processes)
UMP_MCP_ALLOW_ANONYMOUS=false

UMP_MCP_HOST=0.0.0.0
UMP_MCP_PORT=8000
UMP_MCP_LOG_LEVEL=INFO
UMP_MCP_UMP_REQUEST_TIMEOUT=30

# Public hostname Traefik routes to this service (docker-compose.yml)
UMP_MCP_DOMAIN=mcp.example.org
