# UMP server root, without a version prefix (matches UMP's own
# UMP_API_SERVER_URL_PREFIX, default "/")
UMP_MCP_UMP_API_BASE_URL=http://localhost:5000

# UMP 3.0 serves the tool catalog and the OGC API Processes surface under
# separate, independently versioned prefixes. Repoint these at a new UMP
# contract without needing a release here.
UMP_MCP_UMP_CATALOG_PREFIX=/mcp/v1
UMP_MCP_UMP_OGC_PREFIX=/v1.0

# Keycloak as reachable from this service
UMP_MCP_KEYCLOAK_URL=http://localhost:8080
UMP_MCP_KEYCLOAK_REALM=UMP

# Set when tokens are issued under a public URL but Keycloak is reached
# internally under a different one (typical in k8s):
# UMP_MCP_KEYCLOAK_ISSUER=https://auth.example.com/realms/UMP
# UMP_MCP_JWKS_URL=http://keycloak:8080/realms/UMP/protocol/openid-connect/certs

# Expected JWT audience. Leaving this unset disables the audience check —
# configure a Keycloak audience mapper and set it in production.
# UMP_MCP_AUDIENCE=ump-client

# Accept requests without a JWT (UMP then only exposes anonymous-access processes)
UMP_MCP_ALLOW_ANONYMOUS=false

# Public URL of this server's MCP endpoint — the OAuth resource identifier
# (RFC 9728). Publishing it lets MCP clients discover Keycloak and log the user
# in themselves (auth-code + PKCE, with refresh) instead of being handed a
# short-lived token by hand. Cannot be inferred: the ingress terminates TLS.
# Unset disables discovery; bearer validation is unaffected.
# UMP_MCP_RESOURCE_URL=https://mcp.example.org/mcp

# Scopes a token must carry, space- or comma-separated. Published as
# scopes_supported and enforced per request (403 insufficient_scope).
# UMP_MCP_REQUIRED_SCOPES=openid ump:use

UMP_MCP_HOST=0.0.0.0
UMP_MCP_PORT=8000
UMP_MCP_LOG_LEVEL=INFO
UMP_MCP_UMP_REQUEST_TIMEOUT=30
